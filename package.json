{
  "name": "architecture-vis",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "deploy:worker": "node scripts/deploy-worker.mjs",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run contrast && npm run build",
    "prepare": "husky",
    "contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@heyputer/puter.js": "2.6.2",
    "@react-router/node": "^8",
    "isbot": "^5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{jsx,json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
